# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# NOTE: .python-version is deliberately NOT ignored. It is the interpreter pin uv reads,
# and the pin only does its job if every machine and CI runner gets the same one. It is
# grouped with the venv above by habit, but it is a committed build input, not local state.
# The exact patch matters: plain "3.12" resolves to 3.12.5, which black refuses to run its
# AST safety check against, so `make lint` fails on a minor-only pin.

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/
pip-wheel-metadata/

# uv / Poetry
.uv/
# (lockfiles are committed: uv.lock / poetry.lock)

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

