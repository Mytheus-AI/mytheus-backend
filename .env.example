# === Clerk (identity) ===
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://<subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<subdomain>.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...            # Svix signing secret for /clerk/webhook

# === Database ===
# Local dev: the docker-compose Postgres. Prod: the self-hosted Postgres on the VPS
# (or a managed pooled Postgres). app.current_org is set transaction-locally per request.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mytheus

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Redpanda (Kafka API) ===
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# === Temporal ===
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus-backend

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === LiveKit ===
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...
LIVEKIT_URL=wss://...livekit.cloud

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=https://...@sentry.io/...

# === App ===
ENVIRONMENT=development
LOG_LEVEL=INFO
