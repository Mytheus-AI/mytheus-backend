# === Clerk (identity) ===
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://<subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<subdomain>.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...            # Svix signing secret for /clerk/webhook
# The session-token claim carrying the tenant. Its value is CLERK's org id (an opaque
# `org_...` string), which api-gateway resolves to our org_id via organizations.clerk_org_id.
# Never parse this claim as a UUID. Claim-absent is an explicit 401, never a 500.
CLERK_JWT_ORG_CLAIM=org_id

# === Database ===
# Local dev: the docker-compose Postgres, published on 5433 so it never collides with
# another local Postgres. Prod: the self-hosted Postgres on the VPS.
# app.current_org is set transaction-locally per request.
#
# WARNING: `postgres` holds rolbypassrls in supabase/postgres, so RLS does NOT apply to
# this connection. Section 3.3 introduces mytheus_app / mytheus_relay / mytheus_admin and
# the application stops using this role. Until then no isolation claim can be trusted.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mytheus

# === Redis ===
REDIS_URL=redis://localhost:6380

# === Redpanda (Kafka API) ===
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# === Temporal ===
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus-backend

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === LiveKit ===
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...
LIVEKIT_URL=wss://...livekit.cloud

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=https://...@sentry.io/...

# === App ===
ENVIRONMENT=development
LOG_LEVEL=INFO
