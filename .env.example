# === Supabase (auth + database) ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>          # Admin API calls (user sync reconciliation)
SUPABASE_JWT_SECRET=<jwt-secret>                       # From Project Settings → API → JWT Secret
SUPABASE_WEBHOOK_SECRET=<webhook-secret>               # Shared secret for DB webhook verification

# === Database ===
# Use the Supabase pooled connection string (Transaction mode, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres

# === Redis / Upstash ===
REDIS_URL=redis://localhost:6379

# === Redpanda (Kafka API) ===
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# === Temporal ===
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=reprise-backend

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === LiveKit ===
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...
LIVEKIT_URL=wss://...livekit.cloud

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=https://...@sentry.io/...

# === App ===
ENVIRONMENT=development
LOG_LEVEL=INFO
