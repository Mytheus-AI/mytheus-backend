# === Clerk (identity) ===
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://<subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<subdomain>.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...            # Svix signing secret for /clerk/webhook
# The session-token claim carrying the tenant. Its value is CLERK's org id (an opaque
# `org_...` string), which api-gateway resolves to our org_id via organizations.clerk_org_id.
# Never parse this claim as a UUID. Claim-absent is an explicit 401, never a 500.
CLERK_JWT_ORG_CLAIM=org_id

# === Database ===
# Local dev: the docker-compose Postgres, published on 5443 so it never collides with
# another local Postgres. Prod: the self-hosted Postgres on the VPS.
# app.current_org is set transaction-locally per request.
#
# THREE ROLES, THREE URLS. Defect D1 was that everything connected as `postgres`, which
# holds rolbypassrls in supabase/postgres, so row-level security did not apply to the
# request path and every tenant_isolation policy was decorative. Never point DATABASE_URL
# at `postgres`, at a superuser, or at any role holding BYPASSRLS: it disables tenant
# isolation everywhere at once and no test will tell you.
#
# The request path. Subject to every tenant_isolation policy. Column-level SELECT on
# `organizations` only, no UPDATE or DELETE on `audit_logs`.
DATABASE_URL=postgresql+asyncpg://mytheus_app:mytheus_app@localhost:5443/mytheus
#
# The outbox relay, and nothing else: SELECT + UPDATE on `outbox` via one permissive
# policy, no grant on any other table. Used by `make run-relay`.
RELAY_DATABASE_URL=postgresql+asyncpg://mytheus_relay:mytheus_relay@localhost:5443/mytheus
#
# The operator seam: the tenant seed script and RTBF purges. Still subject to RLS. Must not
# be reachable from a request handler, so it is deliberately NOT in the web process env.
ADMIN_DATABASE_URL=postgresql+asyncpg://mytheus_admin:mytheus_admin@localhost:5443/mytheus
#
# Schema owner. Runs migrations and `scripts/bootstrap_roles.py` and nothing else.
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5443/mytheus
#
# Dev passwords for `uv run python -m scripts.bootstrap_roles`. In production these come
# from the secrets manager, one per service, never all three in one file.
MYTHEUS_APP_PASSWORD=mytheus_app
MYTHEUS_RELAY_PASSWORD=mytheus_relay
MYTHEUS_ADMIN_PASSWORD=mytheus_admin

# === Redis ===
REDIS_URL=redis://localhost:6390

# === Redpanda (Kafka API) ===
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085

# === Temporal ===
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mytheus-backend

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === LiveKit ===
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...
LIVEKIT_URL=wss://...livekit.cloud

# === meeting-service: audio tap -> transcription-service /internal/audio ===
# Shared secret sent as the X-Internal-Auth header. Unset = the tap never starts (fail closed).
INTERNAL_AUDIO_TOKEN=
TRANSCRIPTION_AUDIO_URL=ws://localhost:8091/internal/audio
AUDIO_TAP_BACKOFF_BASE_SECONDS=0.5
AUDIO_TAP_BACKOFF_CAP_SECONDS=30
# Where taps run. in-process: inside the meeting-service API (single replica only; the default
# when ENVIRONMENT is development/dev/local/test). worker: the API only records the trigger in
# Redis and `python -m services.meeting_service.audio_tap_worker` runs the taps (the default
# everywhere else, including ENVIRONMENT unset). Any other value refuses to start.
AUDIO_TAP_MODE=in-process
# worker mode: TTL of the per-room claim nexus:{org_id}:tap:{meeting_id}; heartbeat every 2 s,
# so a crashed worker's rooms are re-claimed within this many seconds. Must be > 2.
TAP_CLAIM_TTL_SECONDS=30
# Workers (consumers, relay, audio tap worker): set to expose /metrics on this port.
# METRICS_PORT=9100

# === meeting-service: recording egress (mytheus-recordings on R2 / MinIO / S3) ===
RECORDING_ENABLED=false
RECORDING_BUCKET=mytheus-recordings
RECORDING_AUDIO_ONLY=false
# Cold-tier class for the 30-day transition: STANDARD_IA on R2/S3, a tier name on MinIO, or none.
RECORDING_COLD_STORAGE_CLASS=STANDARD_IA
# R2: https://<account_id>.r2.cloudflarestorage.com, region auto. MinIO: http://localhost:9000 + path style.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=https://...@sentry.io/...

# === App ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Key custody (libs/shared/crypto, ADR-0024 / ADR-0026) ===
# MYTHEUS_KEY_CUSTODY: local-env (dev/test only; the default when ENVIRONMENT is a dev value),
# local-file (production on the VPS: keys read from 0400/0600 files owned by the service uid,
# key VALUES in env are refused), kms (documented upgrade path, not implemented). Unset outside
# development = refuse to start. No provider ever generates a key.
# Generate each dev value locally, never commit one:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MYTHEUS_KEY_CUSTODY=local-env
MYTHEUS_KEK_ID=local-1
# local-env only:
MYTHEUS_KEK_BASE64=
# Decrypt-only KEKs during a rotation: id=base64,id=base64
MYTHEUS_KEK_RETIRED=
MYTHEUS_BLIND_INDEX_KEY_BASE64=
# local-file only (paths, never key material):
# MYTHEUS_KEK_FILE=/run/secrets/mytheus_kek
# MYTHEUS_KEK_RETIRED_FILES=file-1=/run/secrets/mytheus_kek_file-1
# MYTHEUS_BLIND_INDEX_KEY_FILE=/run/secrets/mytheus_blind_index_key
# MYTHEUS_KMS_KEY_URI=
#
# Interim service credentials for POST /pii-tokens/mint (pii vault, ADR-0020/0024):
# service=secret pairs, secret >= 32 chars, callers limited to the redaction boundaries.
MYTHEUS_PII_VAULT_CALLER_TOKENS=
# billing-metering-service: POST /billing/internal/budget callers, service=secret (>= 32 chars),
# allowed: agent-runtime-service, rag-service. Unset = the route refuses every caller.
MYTHEUS_BILLING_CALLER_TOKENS=
# alert_only (default) or enforce: whether the agent tier acts on throttled/blocked.
BUDGET_ENFORCEMENT_MODE=alert_only

# === integration-service (P12) ===
# Public origin of the API. Webhooks are {OAUTH_REDIRECT_BASE}/webhooks/{provider}.
OAUTH_REDIRECT_BASE=http://localhost:8000
# Web app origin. The provider OAuth redirect URI to register is the app page
# {APP_BASE_URL}/settings/integrations/callback/{provider}, which completes the flow signed in
# via POST /oauth/{provider}. Also the base of links in Jira and Slack.
APP_BASE_URL=http://localhost:3000
# HMAC key for the OAuth state and the Google push-channel token (32+ characters).
OAUTH_STATE_SECRET=
# A provider is "configured" (and connectable) only when its credentials are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Atlassian OAuth 2.0 (3LO); the client secret also verifies Jira dynamic-webhook JWTs.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Callers of integration-service /internal/*: service=secret (>= 32 chars), allowed
# notification-service (Slack token) and workflow-service (prep brief / summary). The callers read
# their own entry from this same variable.
MYTHEUS_INTEGRATION_CALLER_TOKENS=
# Where notification-service reaches integration-service.
INTEGRATION_SERVICE_URL=http://integration-service:8000
# core-api /internal/* callers: service=secret pairs. integration-service needs its own entry
# (external-status, slack-digest); workflow-service reads /internal/actions/{id}/status.
MYTHEUS_CORE_CALLER_TOKENS=
CORE_API_URL=http://core-api:8000
